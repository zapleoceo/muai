# Vera 3.0 — пример .env. Скопируй в .env и заполни.

# ─── Postgres ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-postgres

# ─── Secrets ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
TOKEN_SECRET=<32-byte-hex-from-openssl>
INTERNAL_SECRET=<32-byte-hex-from-openssl>
# Remote MCP (/mcp). Один токен или именованные: имя попадает в журнал mcp_audit.
# Пусто = сервер отвечает 401 на всё. Токен ≥ 16 символов: openssl rand -hex 32
MCP_TOKENS=claude:<hex>,codex:<hex>
# MCP_TOKEN=<hex>

# ─── Langfuse ─────────────────────────────────────────────────────────
LANGFUSE_SECRET=<32-byte-hex>
LANGFUSE_SALT=<16-byte-hex>

# ─── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_API_ID=<api-id-from-my.telegram.org>
TELEGRAM_API_HASH=<api-hash-from-my.telegram.org>
TELEGRAM_PHONE=+<international-format>
OWNER_TELEGRAM_ID=<your-telegram-user-id>

# ─── Gmail OAuth ──────────────────────────────────────────────────────
GMAIL_CLIENT_ID=<from-google-cloud-console>
GMAIL_CLIENT_SECRET=<from-google-cloud-console>

# ─── Cost caps ────────────────────────────────────────────────────────
VERA_DAILY_GLOBAL_CAP_USD=2.0

# Ежемесячный отчёт бани → Telegram «Веранда и Баня» (scripts/banya_monthly_report.sh,
# docs/deploy-ops.md). Пустые TG_SEND_* = отправка от имени Димы выключена.
TG_SEND_SECRET=
TG_SEND_ALLOWED_CHATS=
BANYA_REPORT_SECRET=
BANYA_REPORT_CHAT_ID=
